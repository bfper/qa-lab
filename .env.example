# Copy to .env and adjust. NEVER commit .env.
# Every host here MUST be local. conftest.py aborts the run otherwise.

# --- Source checkouts (clones with NO git remote) ---
# ABSOLUTE paths only. Relative paths resolve differently for pytest
# (relative to this repo) and for docker compose (relative to docker/),
# which is a debugging afternoon you do not need. Adjust <user>.
MENTORIA_SRC=/home/<user>/lab/src/mentoria
AUTH_SRC=/home/<user>/lab/src/auth-service

# --- Lab endpoints (high ports, never 80/443/5432/8000) ---
AUTH_BASE_URL=http://localhost:18001
BASE_URL=http://localhost:18002

# --- Local database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=qalab
POSTGRES_PASSWORD=qalab
MENTORIA_DB=mentoria
AUTH_DB=auth

# --- Test credentials (seeded by the lab, not real accounts) ---
MENTORA_EMAIL=mentora@qalab.local
MENTORA_PASSWORD=qalab-mentora
MENTORANDO_EMAIL=mentorando@qalab.local
MENTORANDO_PASSWORD=qalab-mentorando

# Lab-only JWT secret. Must differ from production.
JWT_SECRET=qalab-not-a-real-secret
